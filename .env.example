# ============================================================================
# CONTA TOOLS - VARIABLES DE ENTORNO
# ============================================================================
# Copia este archivo a .env.local y completa los valores

# ----------------------------------------------------------------------------
# APLICACIÓN
# ----------------------------------------------------------------------------
APP_NAME="ContaTools"
APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# SUPABASE (Autenticación y Base de Datos)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ----------------------------------------------------------------------------
# DATABASE URL (PostgreSQL directo - para scripts y APIs que no usan Supabase)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://usuario:password@host:5432/database

# ----------------------------------------------------------------------------
# EMAIL (Nodemailer - Gmail con App Password)
# ----------------------------------------------------------------------------
EMAIL_SERVER_USER=tu-email@gmail.com
EMAIL_SERVER_PASSWORD=tu-app-password-gmail
EMAIL_FROM=tu-email@gmail.com

# ----------------------------------------------------------------------------
# OPENROUTER (IA para Generador de Contratos v2)
# ----------------------------------------------------------------------------
# Obtén tu API key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=https://conta-tools.vercel.app
OPENROUTER_SITE_NAME=ContaTools

# Parámetros de generación (opcionales - tienen defaults)
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TOP_P=0.9
OPENROUTER_FREQ_PENALTY=0.1
OPENROUTER_PRES_PENALTY=0.1

# ----------------------------------------------------------------------------
# GROQ (IA para Generador de Cotizaciones - legado)
# ----------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_COMPLETION_TOKENS=384

# ----------------------------------------------------------------------------
# NEXTAUTH (si se usa)
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET=tu-secret-key-segura
NEXTAUTH_URL=http://localhost:3000