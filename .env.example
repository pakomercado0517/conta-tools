# Supabase Configuration (para autenticación)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://postgres:tu-password@db.tu-proyecto-id.supabase.co:5432/postgres

# Variables individuales (alternativa)
POSTGRES_HOST=db.tu-proyecto-id.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-supabase

# Email Configuration (Nodemailer)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=cashtrackrpako@gmail.com
EMAIL_SERVER_PASSWORD=tu-app-password-generado-en-gmail
EMAIL_FROM=cashtrackrpako@gmail.com

# App Configuration
APP_NAME="Conta Tools"
APP_URL=http://localhost:3000

# Development
NODE_ENV=development
