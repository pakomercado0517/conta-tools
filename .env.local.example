# ========================================
# CONFIGURACIÓN DE NEXT.JS Y NEXTAUTH
# ========================================

# Configuración básica de la aplicación
NODE_ENV=development
APP_NAME="Conta Tools"
APP_URL=http://localhost:3000

# NextAuth.js configuración
# Genera un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================

# URL de conexión a PostgreSQL (Supabase o local)
# Formato: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://your-username:your-password@your-host:5432/your-database

# ========================================
# CONFIGURACIÓN DE EMAIL
# ========================================

# Configuración del servidor de email (Gmail)
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Para Gmail necesitas crear una "App Password":
# 1. Ve a tu cuenta de Google
# 2. Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
# 3. Genera una contraseña para "Correo"
# 4. Usa esa contraseña en EMAIL_SERVER_PASSWORD

# ========================================
# CONFIGURACIÓN DE SUPABASE (opcional)
# ========================================

# Si usas Supabase para la base de datos
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# CONFIGURACIÓN DE DESARROLLO
# ========================================

# Habilitar logs de debug en desarrollo
DEBUG=true

# ========================================
# CONFIGURACIÓN DE ARCHIVOS
# ========================================

# Directorio para almacenar archivos temporales
TEMP_DIR=./temp

# ========================================
# CONFIGURACIÓN DE API EXTERNA (opcional)
# ========================================

# Si necesitas integraciones con APIs externas
# API_KEY_EXTERNAL=your-external-api-key

# ========================================
# NOTAS IMPORTANTES
# ========================================

# 1. Copia este archivo como .env.local
# 2. Reemplaza todos los valores "your-*" con tus datos reales
# 3. NUNCA subas .env.local a Git
# 4. El archivo .env.local está ignorado en .gitignore

# Para base de datos local con PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/conta_tools

# Para Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
