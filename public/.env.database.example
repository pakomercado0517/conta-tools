# Configuración de Base de Datos para Desarrollo
# TEMPORAL: Solo para desarrollo, NO usar en producción

# Ubicación del archivo de usuarios temporales
USERS_DB_PATH=./data/users.json

# IMPORTANTE: Para producción, migrar a una de estas opciones:
# 1. Supabase (recomendado)
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# 2. PostgreSQL local
# DATABASE_URL=postgresql://user:password@localhost:5432/contatools

# 3. MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/contatools

# 4. SQLite (mejor que JSON, pero aún limitado)
# DATABASE_URL=file:./dev.db
